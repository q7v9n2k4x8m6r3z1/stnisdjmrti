# TodoDJS Frontend Environment Variables
# Copy to .env and fill in values

# API URL — in production, use https://api.tododjs.com/api
VITE_API_URL=http://localhost:5000/api

# Stripe publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# Public contact address shown on the privacy policy, cookie policy and terms.
# Vite inlines this at BUILD time, so the build host needs it set.
#
# Put the real value in an UNTRACKED file — .env.production.local for a
# production build, .env.local for development. NOT in .env.development or
# .env.production: both are tracked in git and would publish the address.
#
# Unset means those pages display no contact address, which is a compliance
# gap for EU customers — so set it before building for production.
VITE_CONTACT_EMAIL=contact@example.com
